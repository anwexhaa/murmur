# Every value here is also the built-in default, so this file exists to
# document the knobs rather than to be required. Copy to .env only when you
# need to change something.

MURMUR_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=20s

# HTTP_ADDR is per-binary and defaults to :8080 gateway, :8081 social-svc,
# :8082 timeline-svc, :8083 fanout-worker. Set it only when running one
# service on a non-default port.
# HTTP_ADDR=:8080

POSTGRES_DSN=postgres://murmur:murmur@localhost:5432/murmur?sslmode=disable
POSTGRES_MAX_CONNS=16
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=32
REDIS_DIAL_TIMEOUT=5s

NATS_URL=nats://localhost:4222
NATS_CONNECT_TIMEOUT=5s
# -1 reconnects forever, which is what a backend service should do.
NATS_MAX_RECONNECTS=-1
