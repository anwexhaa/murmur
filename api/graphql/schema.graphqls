"""
Murmur's public API.

Connections follow the Relay cursor convention. Murmur has no `offset`
argument anywhere on purpose: OFFSET re-scans every row it skips, and the
backing stores page by key — follow edges on the follower ID, posts on the
ULID, which already sorts by creation time.
"""

scalar Time

type User {
  id: ID!
  handle: String!
  displayName: String!
  createdAt: Time!

  """
  How many accounts follow this one.

  From phase 4 this number decides whether a post is pushed to follower
  timelines or merged in at read time, so it is public here for the same
  reason it exists internally.
  """
  followerCount: Int!

  "Whether the caller follows this account. Null when nobody is signed in."
  viewerFollows: Boolean

  posts(first: Int = 20, after: String): PostConnection!
}

type Post {
  id: ID!
  body: String!
  createdAt: Time!
  author: User!
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}

type PostEdge {
  node: Post!
  cursor: String!
}

type PostConnection {
  edges: [PostEdge!]!
  pageInfo: PageInfo!
}

type FollowResult {
  "False when the edge already existed. Following is idempotent."
  changed: Boolean!
  user: User!
}

type Query {
  "The signed-in account, or null."
  me: User

  user(handle: String!): User

  post(id: ID!): Post

  """
  The caller's home timeline.

  Phase 2 assembles this the obvious way: list who you follow, fetch each of
  their recent posts, merge. That is deliberately the wrong design — it does
  work proportional to how many accounts you follow, on every single read —
  and it is here to be measured before phase 3 replaces it with a timeline
  materialised at write time.
  """
  timeline(first: Int = 50, after: String): PostConnection!
}

type Mutation {
  createPost(body: String!): Post!
  deletePost(id: ID!): DeleteResult!
  follow(userId: ID!): FollowResult!
  unfollow(userId: ID!): FollowResult!

  """
  Create an account and sign in.

  Handles are checked for shape and uniqueness; passwords for length only.
  Composition rules teach people to write Password1! and add less entropy than
  one extra word does.
  """
  register(handle: String!, displayName: String!, password: String!): AuthPayload!

  """
  Exchange a handle and password for a session.

  A wrong password and an unknown handle return the same error after the same
  amount of work. The difference would otherwise be a fast, silent way to find
  out which accounts exist.
  """
  login(handle: String!, password: String!): AuthPayload!

  """
  Exchange a refresh token for a new pair.

  The token presented is spent: it will not work a second time. Presenting a
  spent token ends the whole session -- see `AuthPayload.refreshToken`.
  """
  refresh(refreshToken: String!): AuthPayload!

  "End this session. Idempotent: logging out twice is not an error."
  logout(refreshToken: String!): Boolean!

  """
  Change the caller's password, ending every session including this one.

  The current password is required even though the caller is already signed
  in. That is what stops a stolen access token from becoming a permanent
  account takeover.
  """
  changePassword(currentPassword: String!, newPassword: String!): Boolean!
}

"""
A session.
"""
type AuthPayload {
  """
  A short-lived signed token, sent as `Authorization: Bearer ...` on every
  request. It is not revocable, which is why it is short-lived.
  """
  accessToken: String!

  """
  A long-lived opaque token, sent only to `refresh`.

  It is single-use. Each refresh returns a new one and invalidates the old,
  and presenting an already-spent token revokes the entire chain back to the
  login that started it -- on the reasoning that two parties holding a secret
  meant for one is indistinguishable from theft.
  """
  refreshToken: String!

  "When the access token stops being accepted."
  expiresAt: Time!

  user: User!
}

type DeleteResult {
  "False when the post was already deleted. Deleting is idempotent."
  deleted: Boolean!
  id: ID!
}

"""
A post arriving on the caller's timeline while they are connected.
"""
type TimelineUpdate {
  post: Post!

  """
  True when updates were dropped before this one.

  A client that sees this should refetch the timeline rather than assume its
  view is complete. It is set when the connection's send buffer filled — which
  means the client was reading more slowly than posts arrived, and the server
  chose to keep serving everyone else rather than wait for it.
  """
  gap: Boolean!
}

type Subscription {
  """
  Posts arriving on the caller's timeline, live.

  `after` is the last post ID the client already has. On reconnect, the server
  replays what was missed since that cursor before switching to live delivery,
  bounded by one page — a client away longer than that gets the newest page and
  `gap: true`.

  Delivery is best-effort by design. The timeline itself is materialised in
  Redis and is always authoritative; this stream is a latency optimisation over
  polling it, so a dropped update costs a refetch rather than a lost post.
  """
  timelineUpdates(after: String): TimelineUpdate!
}
